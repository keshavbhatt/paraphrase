# Build
build/
build-*/
cmake-build-*/
CMakeUserPresets.json
compile_commands.json

# Python (eval harness and scripts)
.venv/
__pycache__/
*.py[cod]
.mypy_cache/
.ruff_cache/
.pytest_cache/
