.vscode/
.idea/
*.user
*.user.*
.cache/
.qtcreator/

# Generated
*.o
*.a
*.so
*.autosave

# OS
.DS_Store
Thumbs.db

# Local agent state: settings, worktrees, anything a session leaves behind
.claude/

# Secrets and credentials
.env
.env.*
*.pem
*.key
*.p12
*.credentials

# Scratch output
*.log
