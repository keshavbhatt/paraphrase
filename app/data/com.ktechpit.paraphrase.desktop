[Desktop Entry]
Type=Application
Name=Paraphrase
GenericName=Offline AI Writing Assistant
Comment=Offline AI grammar checker
Exec=paraphrase-app
Icon=com.ktechpit.paraphrase
Terminal=false
Categories=Utility;TextTools;
Keywords=grammar;spelling;spell;proofread;rewrite;paraphrase;tone;reply;email;summarize;summary;translate;Hindi;Hinglish;writing;assistant;AI;LLM;offline;
StartupNotify=true
SingleMainWindow=true
Actions=popup;

[Desktop Action popup]
Name=Work on the selected text
Exec=paraphrase-app --popup
